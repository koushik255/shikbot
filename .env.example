TELEGRAM_BOT_TOKEN=
FIREWORKS_API_KEY=

# Comma-separated Telegram numeric user IDs that can use the bot.
OWNER_TELEGRAM_IDS=

# Pi model selection.
PI_PROVIDER=fireworks
PI_MODEL=accounts/fireworks/models/kimi-k2p5
PI_THINKING_LEVEL=medium

# To use ChatGPT Plus/Pro Codex OAuth instead:
# 1. Run: npm run login:codex
# 2. Set:
# PI_PROVIDER=openai-codex
# PI_MODEL=gpt-5.5
# Optional custom auth/usage file paths:
# PI_AUTH_FILE=.pi-auth.json
# PI_USAGE_FILE=.pi-usage.json
